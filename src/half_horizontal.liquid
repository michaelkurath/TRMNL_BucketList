{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign title = settings.list_title | default: "Bucket List" %}
{% assign raw_items = settings.bucket_items | default: "" %}
{% assign lines = raw_items | newline_to_br | split: "<br />" %}
{% assign mode = settings.display_mode | default: "focus" | downcase %}
{% assign show_completed_value = settings.show_completed | append: "" | strip | downcase %}
{% assign hide_completed = false %}
{% if settings.show_completed == false or show_completed_value == "false" or show_completed_value == "0" or show_completed_value == "no" or show_completed_value == "off" %}{% assign hide_completed = true %}{% endif %}
{% assign item_limit = settings.max_items | default: "7" | plus: 0 %}
{% if item_limit <= 0 %}{% assign item_limit = 7 %}{% endif %}
{% assign total = 0 %}
{% assign open = 0 %}
{% assign pending_pool = "" %}
{% assign focus_count = 0 %}

{% for raw in lines %}
  {% assign line = raw | strip %}
  {% if line != "" %}
    {% assign total = total | plus: 1 %}
    {% assign is_done = false %}
    {% if line contains "[x]" or line contains "[X]" %}{% assign is_done = true %}{% endif %}
    {% unless is_done %}{% assign open = open | plus: 1 %}{% endunless %}
    {% if is_done == false or hide_completed == false %}
      {% assign pending_pool = pending_pool | append: line | append: "||" %}
      {% assign focus_count = focus_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

{% comment %}sample chooses a new open item whenever TRMNL renders the recipe.{% endcomment %}
{% assign focus_line = pending_pool | split: "||" | sample | strip %}
{% if focus_line == empty or focus_line == "" %}
  {% assign focus_name = "Add your first item" %}
{% else %}
  {% assign focus_parts = focus_line | split: "|" %}
  {% assign focus_name = focus_parts[0] | strip | remove: "[ ]" | remove: "[x]" | remove: "[X]" | strip %}
{% endif %}
{% if mode contains "list" %}{% assign active_mode = "List" %}{% else %}{% assign active_mode = "Focus" %}{% endif %}

<div class="layout layout--col layout--stretch">
  {% if total == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y w--full h--full"><span class="value value--xxlarge text--center w--full" data-fit-value="true" data-value-fit="true" data-value-fit-max-height="130">Add your first item</span></div>
  {% elsif mode contains "list" %}
    <div class="columns stretch-x" data-overflow="true" data-overflow-max-height="140" data-overflow-max-cols="2" data-overflow-counter="false"><div class="column">
      {% assign displayed = 0 %}
      {% for raw in lines %}
        {% assign line = raw | strip %}
        {% if line != "" and displayed < item_limit %}
          {% assign is_done = false %}{% if line contains "[x]" or line contains "[X]" %}{% assign is_done = true %}{% endif %}
          {% assign should_show = true %}{% if is_done and hide_completed %}{% assign should_show = false %}{% endif %}
          {% if should_show %}
            {% assign displayed = displayed | plus: 1 %}
            {% assign parts = line | split: "|" %}
            {% assign item_name = parts[0] | strip | remove: "[ ]" | remove: "[x]" | remove: "[X]" | strip %}
            {% assign item_category = parts[1] | default: "Someday" | strip %}
            {% assign item_note = parts[2] | default: "" | strip %}
            <div class="item"><div class="meta"><span class="index">{% if is_done %}x{% else %}-{% endif %}</span></div><div class="content"><span class="title title--small">{{ item_name }}</span><span class="description description--small">{{ item_category }}{% if item_note != "" %} | {{ item_note }}{% endif %}</span></div></div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div></div>
  {% else %}
    <div class="flex flex--col flex--center-x flex--center-y w--full h--full"><span class="value value--xxxlarge text--center w--full" data-fit-value="true" data-value-fit="true" data-value-fit-max-height="130">{% if focus_count == 0 %}All items completed{% else %}{{ focus_name }}{% endif %}</span></div>
  {% endif %}
</div>

<div class="title_bar"><span class="title">{{ title }}</span><span class="instance">{{ active_mode }}</span></div>
