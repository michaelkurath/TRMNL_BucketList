{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign title = settings.list_title | default: "Bucket List" %}
{% assign raw_items = settings.bucket_items | default: "" %}
{% assign lines = raw_items | newline_to_br | split: "<br />" %}
{% assign mode = settings.display_mode | default: "focus" | downcase %}
{% assign show_completed_value = settings.show_completed | append: "" | strip | downcase %}
{% assign hide_completed = false %}
{% if settings.show_completed == false or show_completed_value == "false" or show_completed_value == "0" or show_completed_value == "no" or show_completed_value == "off" %}{% assign hide_completed = true %}{% endif %}
{% assign item_limit = settings.max_items | default: "7" | plus: 0 %}
{% if item_limit <= 0 %}{% assign item_limit = 7 %}{% endif %}
{% assign total = 0 %}
{% assign open = 0 %}
{% assign open_positions = "" %}
{% assign focus_count = 0 %}

{% for raw in lines %}
  {% assign line = raw | strip %}
  {% if line != "" %}
    {% assign total = total | plus: 1 %}
    {% assign is_done = false %}
    {% if line contains "[x]" or line contains "[X]" %}{% assign is_done = true %}{% endif %}
    {% unless is_done %}
      {% assign open = open | plus: 1 %}
      {% assign open_positions = open_positions | append: forloop.index0 | append: "," %}
    {% endunless %}
    {% if is_done == false or hide_completed == false %}
      {% assign focus_count = focus_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

{% unless mode contains "list" %}
  {% if open > 0 %}
    {% comment %}Unix time starts on a Thursday. Shift by three days to rotate on local Mondays.{% endcomment %}
    {% assign local_seconds = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
    {% assign week_index = local_seconds | plus: 259200 | divided_by: 604800 | floor %}
    {% assign focus_index = week_index | modulo: open %}
    {% assign positions = open_positions | split: "," %}
    {% assign line_index = positions[focus_index] | plus: 0 %}
    {% assign focus_parts = lines[line_index] | split: "|" %}
    {% assign focus_name = focus_parts[0] | remove: "[ ]" | strip %}
    {% assign next_step = focus_parts[2] | default: "" | strip %}
  {% endif %}
{% endunless %}
{% if mode contains "list" %}{% assign active_mode = "List" %}{% else %}{% assign active_mode = "Focus" %}{% endif %}

<div class="layout layout--col layout--stretch{% if mode contains 'list' %} layout--top{% endif %}">
  {% if total == 0 %}
    <div class="flex flex--col flex--center-x flex--center-y w--full h--full"><span class="title title--large text--center w--full" data-fit-value="true" data-value-fit="true" data-value-fit-max-height="130">Add your first item</span></div>
  {% elsif mode contains "list" %}
    {% if focus_count == 0 %}
      <div class="flex flex--col flex--center-x flex--center-y w--full h--full"><span class="value value--xlarge text--center w--full" data-fit-value="true" data-value-fit="true" data-value-fit-max-height="130">All items completed</span></div>
    {% else %}
      <div class="columns" data-overflow="true" data-overflow-max-height="auto" data-overflow-max-cols="1" data-overflow-counter="true"><div class="column">
      {% assign displayed = 0 %}
      {% for raw in lines %}
        {% assign line = raw | strip %}
        {% if line != "" and displayed < item_limit %}
          {% assign is_done = false %}{% if line contains "[x]" or line contains "[X]" %}{% assign is_done = true %}{% endif %}
          {% assign should_show = true %}{% if is_done and hide_completed %}{% assign should_show = false %}{% endif %}
          {% if should_show %}
            {% assign displayed = displayed | plus: 1 %}
            {% assign parts = line | split: "|" %}
            {% assign item_name = parts[0] | strip | remove: "[ ]" | remove: "[x]" | remove: "[X]" | strip %}
            <div class="item{% if is_done %} item--emphasis-3{% endif %}"><div class="meta"><span class="index">{% if is_done %}x{% else %}-{% endif %}</span></div><div class="content"><span class="title lg:title--large w--full" data-clamp="1" data-clamp-lg="2">{{ item_name }}</span></div></div>
          {% endif %}
        {% endif %}
      {% endfor %}
      </div></div>
    {% endif %}
  {% else %}
    <div class="flex flex--col flex--center-x flex--center-y gap w--full h--full">
      {% if open == 0 %}
        <span class="title lg:title--xxlarge text--center w--full">All items completed</span>
      {% else %}
        <span class="label lg:label--large">THIS WEEK</span>
        <span class="value value--large lg:value--xlarge text--center w--full" data-fit-value="true" data-value-fit="true" data-value-fit-max-height="70">{{ focus_name | escape }}</span>
        {% if next_step != "" %}
          <span class="description lg:description--large text--center w--full" data-clamp="2"><strong>Next step:</strong> {{ next_step | escape }}</span>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}
</div>

<div class="title_bar"><span class="title">{{ title }}</span><span class="instance">{{ active_mode }}</span></div>
